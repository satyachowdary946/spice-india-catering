# Local development
DATABASE_URL=sqlite:///./catering.db
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=0

# Production customer lifecycle + admin email notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Spice India Catering <catering@spiceindiacatering.party>
ADMIN_NOTIFICATION_EMAIL=

# Meta WhatsApp Cloud API — automatic ADMIN notification when customer confirms
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_TO=
WHATSAPP_GRAPH_VERSION=v22.0
WHATSAPP_CONFIRM_TEMPLATE_NAME=admin_order_confirmed
WHATSAPP_CONFIRM_TEMPLATE_LANG=en_US

# The WhatsApp confirmation template body must accept these 10 variables in order:
# 1 Order ID, 2 Customer, 3 Guests, 4 Event, 5 Date, 6 Day,
# 7 Event Time, 8 Delivery Time, 9 Total Price, 10 Admin Order URL.

# Cloudflare R2 — durable master-menu and food-image storage (optional but recommended)
# Create an R2 bucket and API token with Object Read & Write permission.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=spice-india-catering-media
# Optional. If blank, the app derives https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Recommended: your public R2 custom domain, e.g. https://media.spiceindiacatering.party
# If blank, the website securely proxies R2 menu images itself.
R2_PUBLIC_BASE_URL=
