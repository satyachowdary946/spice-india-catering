# Required in production. Generate a long random value.
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=1

# Local default is SQLite. For production, use a persistent PostgreSQL database.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional: real WhatsApp Cloud API notifications for new quote requests.
# If these are not configured, quote requests still appear immediately in Admin.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_WHATSAPP_TO=
WHATSAPP_GRAPH_VERSION=v22.0
